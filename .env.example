# Public — inlined into the browser bundle by Next.js. Never a secret.
# Validated in src/config/env.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — read only from src/server/*. Validated in src/server/env.ts.
# NODE_ENV is set by Next / tooling; do not set it here.
APP_ENV=development
GIT_COMMIT_SHA=dev

# Local dev uses trust auth — no credentials. Deployed environments inject a full
# URL via ECS Secrets Manager / SSM; never commit real credentials.
DATABASE_URL=postgresql://localhost:5432/iol_property_plus

# Propdata feed (server-only) — HTTP Basic credentials for the listing adapter.
# Empty here on purpose; set real values in .env.local (git-ignored). Never commit.
PROP_DATA_API_USERNAME=
PROP_DATA_API_PASSWORD=
PROP_DATA_API_LOGIN_URL=

# PropCtrl feed (server-only) — HTTP Basic credentials for the listing adapter.
# Empty here on purpose; set real values in .env.local (git-ignored). Never commit.
PROPCTRL_API_USERNAME=
PROPCTRL_API_PASSWORD=
PROPCTRL_API_BASE_URL=

# RE/MAX feed (server-only) — AWS SigV4 credentials + usage-plan API key.
# Every request is signed (execute-api, eu-west-1) AND carries x-api-key.
# Empty here on purpose; set real values in .env.local (git-ignored). Never commit.
REMAX_ACCESS_KEY=
REMAX_SECRET_KEY=
REMAX_API_KEY=
REMAX_API_BASE_URL=
