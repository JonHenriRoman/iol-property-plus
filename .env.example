# Public runtime configuration — safe for browser exposure.
# Any NEXT_PUBLIC_* value is embedded in the client bundle. Never put a secret here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only configuration — read only from server modules.
# Provide real values through your local .env.local (git-ignored) or, in
# deployed environments, through ECS Secrets Manager / SSM references.
# DATABASE_URL=postgres://user:password@localhost:5432/iol_property_plus
