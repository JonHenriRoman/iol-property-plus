# Public — inlined into the browser bundle by Next.js. Never a secret.
# Validated in src/config/env.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — read only from src/server/*. Validated in src/server/env.ts.
# NODE_ENV is set by Next / tooling; do not set it here.
APP_ENV=development
GIT_COMMIT_SHA=dev

# Server-only secrets — inject via ECS Secrets Manager / SSM. Never commit real values.
# DATABASE_URL=postgres://user:password@localhost:5432/iol_property_plus
