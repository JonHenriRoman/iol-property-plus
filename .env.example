# Public — inlined into the browser bundle by Next.js. Never a secret.
# Validated in src/config/env.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — read only from src/server/*. Validated in src/server/env.ts.
# NODE_ENV is set by Next / tooling; do not set it here.
APP_ENV=development
GIT_COMMIT_SHA=dev

# Local dev uses trust auth — no credentials. Deployed environments inject a full
# URL via ECS Secrets Manager / SSM; never commit real credentials.
DATABASE_URL=postgresql://localhost:5432/iol_property_plus

# Propdata feed (server-only) — HTTP Basic credentials for the listing adapter.
# Empty here on purpose; set real values in .env.local (git-ignored). Never commit.
PROP_DATA_API_USERNAME=
PROP_DATA_API_PASSWORD=
PROP_DATA_API_LOGIN_URL=

# PropCtrl feed (server-only) — HTTP Basic credentials for the listing adapter.
# Empty here on purpose; set real values in .env.local (git-ignored). Never commit.
PROPCTRL_API_USERNAME=
PROPCTRL_API_PASSWORD=
PROPCTRL_API_BASE_URL=

# RE/MAX feed (server-only) — AWS SigV4 credentials + usage-plan API key.
# Every request is signed (execute-api, eu-west-1) AND carries x-api-key.
# Empty here on purpose; set real values in .env.local (git-ignored). Never commit.
REMAX_ACCESS_KEY=
REMAX_SECRET_KEY=
REMAX_API_KEY=
REMAX_API_BASE_URL=

# Entegral feed (server-only) — HTTP Basic credentials for the pull adapter
# (officeslist + officelistings on sync.entegral.net).
# Empty here on purpose; set real values in .env.local (git-ignored). Never commit.
ENTEGRAL_USERNAME=
ENTEGRAL_PASSWORD=
ENTEGRAL_API_BASE_URL=

# PropertyEngine feed (server-only) — the Gumtree Pro "Real Estate Standard
# Template Feed" v1.0.1 schema. The URL is still pending from PropertyEngine: the
# schema doc specifies the file format only, never a hosting URL or a schedule.
# Auth is optional — the doc says "Authorization may be implemented" at the
# hosting URL. Leave the token blank if the URL itself carries an embedded token.
# Empty here on purpose; set real values in .env.local (git-ignored). Never commit.
PROPERTYENGINE_FEED_URL=
PROPERTYENGINE_FEED_AUTH_TOKEN=
# bearer (default) | basic — only read when the token above is set.
PROPERTYENGINE_FEED_AUTH_SCHEME=

# Fusion FeedStore feed (server-only) — Private Property SA's event-sourced XML
# sync. FUSION_CLIENT_ID is the numeric id issued by Fusion; FUSION_PASSWORD is
# the account password (it feeds the per-call SecurityToken digest — treat it as
# a raw credential). FUSION_API_BASE_URL overrides the production sync host; point
# it at the doc's QA host for testing.
# Empty here on purpose; set real values in .env.local (git-ignored). Never commit.
FUSION_CLIENT_ID=
FUSION_PASSWORD=
FUSION_API_BASE_URL=

# AllSA Property feed (server-only) — the public, unauthenticated iol.ashx XML
# feed. No credentials: each agency's `agencyid` lives on its own feed_sources
# row (auth_config->>'agency_id'), not here. ALLSA_FEED_BASE_URL only overrides
# the default endpoint host; leave blank in normal use.
ALLSA_FEED_BASE_URL=

# MyRoof feed (server-only) — per-franchise bracket-KV feed at
# https://rat.myroof.co.za/<token>. The opaque token is the credential and lives
# on each franchise's feed_sources row (auth_config->>'token'), not here.
# MYROOF_FEED_BASE_URL only overrides the default host; leave blank in normal use.
MYROOF_FEED_BASE_URL=

# PropertyPost feed (server-only) — one static per-agency URL (e.g.
# .../BstProperties.txt), a plain GET with no auth of any kind. The full feed URL
# lives on each agency's feed_sources row (base_url), not here.
# PROPERTYPOST_FEED_BASE_URL only supplies a default host for a row that omits it;
# leave blank in normal use.
PROPERTYPOST_FEED_BASE_URL=

# RT3 (Rawson) feed (server-only) — one bracket-KV file per province at
# {host}/iol-{Province}.txt, a plain GET with no auth. Which provinces an agency
# publishes is on its feed_sources row (auth_config->>'provinces'), not here.
# RT3_FEED_BASE_URL only overrides the default host; leave blank in normal use.
RT3_FEED_BASE_URL=

# Webbox feed (server-only) — one XML file per site at
# {domain}/template/feeds,WebboxFeedForSite.vm/siteid/<id>/securitykey/<key>/feed.xml.
# The URL itself is the credential: the domain and the siteid/securitykey pair
# live on each site's feed_sources row (base_url + auth_config), not here.
# WEBBOX_FEED_URL_TEMPLATE only overrides the shared URL path template; leave
# blank in normal use.
WEBBOX_FEED_URL_TEMPLATE=

# Re-hosted listing media (server-only) — where the media route handler reads
# downloaded photos from. Defaults to <repo>/data/media when unset.
MEDIA_ROOT_DIR=

# Internal feed-operations UI at /ops (server-only). Always on in local dev.
# Set to 1 (or true) to enable it in a deployed environment — only once an auth
# gate is in front of it (see src/server/ops-access.ts). Leave blank otherwise.
OPS_UI_ENABLED=
